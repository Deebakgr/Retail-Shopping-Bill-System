@Metadata.layer: #CORE

@UI.headerInfo: {
  typeName:       'Bill Item',
  typeNamePlural: 'Bill Items',
  title:          { type: #STANDARD, value: 'ProductID' },
  description:    { type: #STANDARD, value: 'ProductName' }
}

annotate view ZC_BillItem with
{


  @UI.lineItem:       [{ position: 10, importance: #LOW }]
  @UI.identification: [{ position: 10 }]
  ItemPosition;

 
  @UI.lineItem:       [{ position: 20, importance: #HIGH }]
  @UI.identification: [{ position: 20 }]
  ProductID;


  @UI.lineItem:       [{ position: 30, importance: #HIGH }]
  @UI.identification: [{ position: 30 }]
  ProductName;


  @UI.lineItem:       [{ position: 40, importance: #MEDIUM }]
  @UI.identification: [{ position: 40 }]
  Quantity;


  @UI.lineItem:       [{ position: 50, importance: #MEDIUM }]
  @UI.identification: [{ position: 50 }]
  UnitPrice;


  @UI.lineItem:       [{ position: 60, importance: #HIGH }]
  @UI.identification: [{ position: 60 }]
  Subtotal;


  @UI.lineItem:       [{ position: 70, importance: #LOW }]
  @UI.identification: [{ position: 70 }]
  Currency;

 
  @UI.lineItem:       [{ position: 80, importance: #LOW }]
  @UI.identification: [{ position: 80 }]
  LastChangedAt;

}